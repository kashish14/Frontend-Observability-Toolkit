{
  "name": "frontend-observability-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade frontend observability: SDK, analytics engine, and dashboard",
  "scripts": {
    "build": "npm run build:sdk && npm run build:analytics && npm run build:backend && npm run build:dashboard",
    "build:sdk": "npm run build --workspace=sdk",
    "build:analytics": "npm run build --workspace=analytics-engine",
    "build:backend": "npm run build --workspace=mock-backend",
    "build:dashboard": "npm run build --workspace=dashboard",
    "start:backend": "npm run start --workspace=mock-backend",
    "start:dashboard": "npm run start --workspace=dashboard",
    "test": "npm run test --workspaces --if-present",
    "test:sdk": "npm run test --workspace=sdk",
    "test:integration": "npm run test --workspace=tests"
  },
  "workspaces": [
    "sdk",
    "analytics-engine",
    "mock-backend",
    "dashboard",
    "tests"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@angular/animations": "17.3.12",
    "@angular/common": "17.3.12",
    "@angular/compiler": "17.3.12",
    "@angular/core": "17.3.12",
    "@angular/forms": "17.3.12",
    "@angular/platform-browser": "17.3.12",
    "@angular/platform-browser-dynamic": "17.3.12",
    "@angular/router": "17.3.12"
  },
  "devDependencies": {
    "@angular/compiler": "17.3.12"
  }
}
